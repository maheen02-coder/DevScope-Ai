# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4000
TRUST_PROXY=false

# ── Security ───────────────────────────────────────────────────────────────
# REQUIRED in production. Use a long random value, e.g. `openssl rand -hex 48`.
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# ── Database ───────────────────────────────────────────────────────────────
# SQLite file. The directory is created automatically.
DATABASE_PATH=./data/devscope.db

# ── GitHub ─────────────────────────────────────────────────────────────────
# Optional, but strongly recommended: raises the API limit from 60 to 5,000 req/h.
# A fine-grained token with public repo read access is enough.
GITHUB_TOKEN=

# ── Groq ───────────────────────────────────────────────────────────────────
# REQUIRED for AI analysis and chat. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── OAuth (optional, free) ───────────────────────────────────────────────────
# Create OAuth apps at https://github.com/settings/developers and
# https://console.cloud.google.com/apis/credentials. Callback URLs:
#   https://your-host/api/auth/oauth/github/callback
#   https://your-host/api/auth/oauth/google/callback
# OAUTH_BASE_URL must be the public origin (no trailing slash) for callbacks.
OAUTH_BASE_URL=http://localhost:4000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Observability ──────────────────────────────────────────────────────────
# Structured pino logs: trace, debug, info, warn, error, fatal, silent.
LOG_LEVEL=debug
# Prometheus metrics at /api/metrics. When set, requests need
# "Authorization: Bearer <token>". In production the endpoint is hidden without it.
METRICS_TOKEN=

# ── Quotas (rolling 24h, enforced server-side) ──────────────────────────────
ANALYSIS_DAILY_LIMIT=10
CHAT_DAILY_LIMIT=60

# ── AI context budgeting ───────────────────────────────────────────────────
# Unset input limits are derived from the model context window and stay below it.
# Override AI_CONTEXT_WINDOW if GROQ_MODEL is not in the built-in registry.
# Keep AI_MAX_INPUT_TOKENS at or below your Groq tokens-per-minute allowance so
# large repositories use batching instead of relying on the 413 retry.
# AI_CONTEXT_WINDOW=131072
# AI_MAX_INPUT_TOKENS=48000
# AI_MAX_TOTAL_INPUT_TOKENS=
# AI_MAX_OUTPUT_TOKENS=3200
# AI_MAX_FILE_TOKENS=3000
# AI_MAX_FILES=18
# AI_MAX_README_TOKENS=4000
# AI_MAX_BATCHES=3

# ── Advanced ───────────────────────────────────────────────────────────────
# AI_TIMEOUT_MS=90000
# BCRYPT_ROUNDS=12
# RATE_LIMIT_ENABLED=true
# GITHUB_API_BASE=https://api.github.com
# GROQ_API_BASE=https://api.groq.com
